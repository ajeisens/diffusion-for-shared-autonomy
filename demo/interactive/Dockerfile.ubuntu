# Dockerfile for KTO Lunar Lander Demo - Ubuntu Base
# Python 3.10 + Drake + Pygame
# Ubuntu has better support for Drake's MOSEK library requirements

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install Python 3.10 and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python
    python3.10 \
    python3.10-dev \
    python3-pip \
    # Build tools
    build-essential \
    cmake \
    git \
    pkg-config \
    # Graphics and display
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # X11 for pygame
    libx11-6 \
    libxrandr2 \
    libxi6 \
    libxcursor1 \
    libxinerama1 \
    libxxf86vm1 \
    # Audio (pygame)
    libasound2-dev \
    libpulse-dev \
    # SDL for pygame
    libsdl2-dev \
    libsdl2-image-dev \
    libsdl2-mixer-dev \
    libsdl2-ttf-dev \
    # Drake dependencies (additional for Ubuntu)
    libgfortran5 \
    libopenblas-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.10 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1

# Upgrade pip
RUN python -m pip install --upgrade pip

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install Drake first (large download, ~800MB)
RUN pip install --no-cache-dir drake==1.34.0

# Install other Python dependencies
RUN pip install --no-cache-dir \
    numpy==1.26.4 \
    scipy==1.13.0 \
    pygame==2.5.2 \
    gym==0.26.2 \
    torch==2.2.0

# Copy project files
COPY . /app

# Set Python path
ENV PYTHONPATH=/app:$PYTHONPATH

# Configure pygame for X11 rendering
ENV SDL_VIDEODRIVER=x11
ENV SDL_AUDIODRIVER=dummy

# Create directory for recorded episodes
RUN mkdir -p /app/recorded_episodes

# Default command
CMD ["python", "play.py"]
